# ---------------------------------------------------------------------------
# SRAI Systems — website environment configuration
# Copy to `.env.local` (git-ignored) and fill in. Every value is optional:
# with none set, the site runs with analytics disabled and the contact form in
# its "email us directly" mode. Nothing fakes success, nothing tracks silently.
# ---------------------------------------------------------------------------

# --- Contact form ----------------------------------------------------------
# FASTEST PATH (about two minutes, free):
#   1. Go to https://web3forms.com and enter contact@sraisystems.in
#   2. They email you an access key. Paste it below.
#   3. Rebuild and deploy. Submissions arrive at contact@sraisystems.in.
# That is the only variable you need — the endpoint is inferred.
VITE_CONTACT_ACCESS_KEY=

# Only if you use a different provider or your own serverless function.
# Any URL that accepts a JSON POST and returns 2xx on success works:
# Formspree https://formspree.io/f/<id> · Formspark https://submit-form.com/<id>
VITE_CONTACT_ENDPOINT=

# --- Analytics -------------------------------------------------------------
# "posthog" | "ga4" | "none"   (default: none — zero tracking, zero requests)
VITE_ANALYTICS_PROVIDER=none

# PostHog (recommended — see docs/analytics.md)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Google Analytics 4 (alternative)
VITE_GA4_ID=
